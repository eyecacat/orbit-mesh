{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.11.0",
      "pnpm": {
        "installCommand": "pnpm install --no-frozen-lockfile"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "node": "22.11.0",
      "pnpm": {
        "installCommand": "pnpm install --no-frozen-lockfile"
      },
      "env": {
        "EAS_BUILD_SKIP_LOCKFILE_CHECK": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "node": "22.11.0",
      "pnpm": {
        "installCommand": "pnpm install --no-frozen-lockfile"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
